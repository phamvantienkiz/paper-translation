# =============================================================================
# Paper Translation — File cấu hình môi trường (.env)
# Sao chép tệp này thành ".env" và điền các thông tin tương ứng.
# =============================================================================

# 1. Cấu hình Máy chủ & Cơ sở dữ liệu
PROJECT_NAME="Paper Translation"
DATABASE_URL="sqlite+aiosqlite:///./paper_translation.db"
MAX_UPLOAD_SIZE_BYTES=52428800

# =============================================================================
# 2. CẤU HÌNH AI / LLM (THỐNG NHẤT THEO CHUẨN OPENAI-COMPATIBLE)
# Hệ thống sử dụng giao thức chuẩn OpenAI Chat Completions (/chat/completions).
# Chọn 1 trong các Preset bên dưới và cấu hình theo nhu cầu của bạn:
# =============================================================================

# -----------------------------------------------------------------------------
# PRESET A: Google Gemini API (Khuyên dùng cá nhân - gemini-3.5-flash-lite)
# Lấy API Key miễn phí tại: https://aistudio.google.com/
# -----------------------------------------------------------------------------
LLM_API_BASE="https://generativelanguage.googleapis.com/v1beta/openai"
LLM_API_KEY="AIzaSyYourGeminiApiKeyHere"
LLM_MODEL="gemini-3.5-flash-lite"
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60.0

# -----------------------------------------------------------------------------
# PRESET B: OpenAI API (ChatGPT)
# Lấy API Key tại: https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
# LLM_API_BASE="https://api.openai.com/v1"
# LLM_API_KEY="sk-proj-YourOpenAiApiKeyHere"
# LLM_MODEL="gpt-4o-mini"

# -----------------------------------------------------------------------------
# PRESET C: Chạy Local Offline với Ollama (qwen2.5, llama3.1, mistral)
# Tải Ollama tại: https://ollama.com/
# Chạy lệnh: ollama run qwen2.5:7b
# -----------------------------------------------------------------------------
# LLM_PROVIDER="ollama"
# LLM_API_BASE="http://localhost:11434/v1"
# LLM_API_KEY="ollama"
# LLM_MODEL="qwen2.5:7b"

# -----------------------------------------------------------------------------
# PRESET D: Chạy Local Offline với Llama.cpp (server.exe)
# -----------------------------------------------------------------------------
# LLM_PROVIDER="llama_cpp"
# LLM_API_BASE="http://localhost:8080/v1"
# LLM_API_KEY="none"
# LLM_MODEL="llama-3.1-8b-instruct"

# -----------------------------------------------------------------------------
# PRESET E: Chạy Local Offline với LM Studio
# Tải LM Studio tại: https://lmstudio.ai/ (Bật Local Server port 1234)
# -----------------------------------------------------------------------------
# LLM_PROVIDER="lm_studio"
# LLM_API_BASE="http://localhost:1234/v1"
# LLM_API_KEY="lm-studio"
# LLM_MODEL="qwen2.5-7b-instruct"

# -----------------------------------------------------------------------------
# PRESET F: Model dịch chuyên dụng tự host (vLLM / FastChat / TGI)
# Cung cấp giao diện chuẩn OpenAI-compatible (/v1/chat/completions)
# -----------------------------------------------------------------------------
# LLM_PROVIDER="self_hosted"
# LLM_API_BASE="http://localhost:8000/v1"
# LLM_API_KEY="none"
# LLM_MODEL="vietnamese-translation-model"

# -----------------------------------------------------------------------------
# PRESET G: DeepSeek API
# -----------------------------------------------------------------------------
# LLM_PROVIDER="openai"
# LLM_API_BASE="https://api.deepseek.com/v1"
# LLM_API_KEY="your-deepseek-api-key"
# LLM_MODEL="deepseek-chat"
